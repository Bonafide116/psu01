{ 
    "version": "2.0.0",
    "tasks": [
        { 
            "label": "Build (Docker toolchain)", 
            "type": "shell", 
            "command": "${workspaceFolder}/build.sh", 
            "group": { 
                "kind": "build", 
                "isDefault": true 
            }, 
            "problemMatcher": "$gcc" 
        }, 
        { 
            "label": "Clean (Docker toolchain)", 
            "type": "shell", 
            "command": "${workspaceFolder}/clean.sh", 
            "group": { 
                "kind": "build", 
                "isDefault": false 
            }, 
            "problemMatcher": []
        }
    ]
} 